{
  "name": "iknowyoucanseeme",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual portfolio of the photographer and ceramicist Alexander Usoltsev (iknowyoucanseeme.xyz), built with Astro.",
  "scripts": {
    "dev": "astro dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:workflows": "actionlint",
    "typecheck": "astro sync && tsc --noEmit && tsc -p tests/e2e/tsconfig.json --noEmit",
    "check": "npm run typecheck && astro check && npm run lint && npm run test:coverage && astro build",
    "intake": "npx tsx tools/intake/cli.ts",
    "copy:review": "npx tsx tools/copy/review.ts",
    "lockfile:normalize": "npx tsx tools/lockfile/normalize.ts",
    "verify:clean-clone": "npx tsx tools/release/clean-clone.ts",
    "build": "astro build",
    "test:e2e": "playwright test",
    "perf:trace": "playwright test -c playwright.perf.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.4.1",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.53.0",
    "@types/node": "^24.0.9",
    "@types/opentype.js": "^1.3.10",
    "@types/qrcode": "^1.5.0",
    "@types/three": "^0.177.0",
    "@vitest/coverage-v8": "^3.2.4",
    "astro": "^5.11.0",
    "eslint": "^9.29.0",
    "fast-check": "^4.1.1",
    "jsdom": "^26.1.0",
    "jsqr": "^1.4.0",
    "node-web-audio-api": "^2.1.0",
    "opentype.js": "^1.3.4",
    "prettier": "^3.6.2",
    "subset-font": "^1.7.1",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "node-html-parser": "^1.1.16",
    "qrcode": "^1.4.1",
    "sharp": "^0.34.2",
    "three": "^0.177.0",
    "tone": "^15.2.6",
    "yaml": "^2.8.0",
    "zod": "^3.25.67"
  },
  "overrides": {
    "@emnapi/runtime": "1.4.3"
  }
}
