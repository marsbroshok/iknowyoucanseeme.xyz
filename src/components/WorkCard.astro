---
/**
 * A work as a list item: thumbnail, title (+ EN subtitle on the EN site),
 * optional territory name, year, and medium badge (or, for a Leak-zone
 * specimen, its museum tag), linking to the work page.
 */
import type { WorkView } from '../domain/WorkView.js';
import WorkImage from './WorkImage.astro';

interface Props {
  work: WorkView;
  /** Territory display name, shown on the works index. */
  territoryName?: string;
  /** Museum-tag label of a Leak-zone specimen (`specimen 03 · Venise · 2025`), shown in mono. */
  specimen?: string;
  /** Whether to append the localized medium label (`photograph` / `ceramic`) to the card meta line. */
  showMedium?: boolean;
}

const { work, territoryName, specimen, showMedium = false } = Astro.props;
const first = work.images[0];
const metaText = `${territoryName ? `${territoryName} · ` : ''}${work.year}${showMedium ? ` · ${work.mediumLabel}` : ''}`;
---
<a class="work-card" href={work.href}>
  {first && (
    <WorkImage
      src={`works/${work.slug}/${first.src}`}
      alt=""
      palette={first.palette}
      sizes="(max-width: 40rem) 50vw, 18rem"
      widths={[320, 640]}
      className="work-card-image"
    />
  )}
  <span class="work-card-title">{work.title}</span>
  {work.subtitle && <span class="work-card-subtitle">{work.subtitle}</span>}
  {specimen ? <span class="work-card-specimen">{specimen}</span> : <span class="work-card-meta">{metaText}</span>}
</a>

<style>
  .work-card {
    display: grid;
    gap: var(--space-1);
    color: var(--text-primary);
    text-decoration: none;
  }
  .work-card:hover .work-card-title,
  .work-card:focus-visible .work-card-title {
    text-decoration: underline;
  }
  .work-card:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 4px;
  }
  .work-card-title {
    font-size: var(--text-lg);
  }
  .work-card-subtitle {
    font-style: italic;
    color: var(--text-secondary);
  }
  .work-card-specimen {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--text-secondary);
  }
  .work-card-meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }
</style>
