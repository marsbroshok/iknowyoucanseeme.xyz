---
/**
 * Work page `/{lang}/works|oeuvres/<slug>/`: large image(s), FR title (+ EN
 * subtitle on the EN site), fragment, metadata line, availability (never a
 * price), contact link pre-filled with the work, prev/next within the
 * territory, and the "See it in the drift" link (`/{lang}/?w=<slug>`: the
 * home page opens the world in front of this work; plain link, no script).
 */
import type { Locale } from '../../i18n/RouteMap.js';
import type { WorkView } from '../../domain/WorkView.js';
import type { WorkBreadcrumb } from '../../domain/TerritoryView.js';
import type { VisualArtworkJsonLd } from '../../domain/JsonLd.js';
import { uiText } from '../../i18n/UiCatalog.js';
import { localizedPath } from '../../i18n/LocalizedPath.js';
import { DeepLink } from '../../world/core/DeepLink.js';
import BaseLayout from '../BaseLayout.astro';
import WorkImage from '../WorkImage.astro';

interface Props {
  lang: Locale;
  work: WorkView;
  prev: WorkView | null;
  next: WorkView | null;
  territory: { title: string; href: string };
  breadcrumb?: WorkBreadcrumb;
  jsonLd: VisualArtworkJsonLd;
  ogImage?: string;
}

const { lang, work, prev, next, territory, jsonLd, ogImage } = Astro.props;
const ui = uiText(lang);
const params = { en: [work.slug], fr: [work.slug] };
const description = work.fragment ? `${work.displayTitle}. ${work.fragment}` : `${work.displayTitle} · ${work.metaLine}`;
---
<BaseLayout
  lang={lang}
  routeKey="works"
  routeParams={params}
  title={`${work.displayTitle} · Alexander Usoltsev`}
  description={description}
  ogImage={ogImage}
  jsonLd={[jsonLd]}
>
  <article class="page work">
    <div class="work-images">
      {work.images.map((img, i) => (
        <WorkImage
          src={`works/${work.slug}/${img.src}`}
          alt={work.alt}
          palette={img.palette}
          sizes="(max-width: 72rem) 100vw, 72rem"
          priority={i === 0}
        />
      ))}
    </div>
    <header class="work-heading">
      <h1>{work.title}</h1>
      {work.subtitle && <p class="subtitle" lang="en">{work.subtitle}</p>}
    </header>
    {work.fragment && <p class="prose fragment">{work.fragment}</p>}
    <p class="meta-line">{work.metaLine}</p>
    <p class="availability">{work.availabilityLabel}</p>
    {work.enquirable && <p><a href={work.contactHref}>{ui.t('work_contact_link')}</a></p>}
    <p class="drift-link"><a href={DeepLink.href(localizedPath('home', lang), work.slug)} data-drift-link>{ui.t('drift_link')}</a></p>
    <p class="territory-link"><a href={territory.href}>{territory.title}</a></p>
    <nav class="prev-next" aria-label={territory.title}>
      {prev && <a rel="prev" href={prev.href}><span class="meta-line">{ui.t('work_prev')}</span> {prev.title}</a>}
      {next && <a rel="next" href={next.href}><span class="meta-line">{ui.t('work_next')}</span> {next.title}</a>}
    </nav>
  </article>
</BaseLayout>

<style>
  .work-images {
    display: grid;
    gap: var(--space-3);
    max-width: 56rem;
  }
  .work-heading {
    margin-top: var(--space-4);
  }
  .subtitle {
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--text-secondary);
  }
  .fragment {
    margin: var(--space-3) 0;
    font-style: italic;
  }
  .availability {
    margin-top: var(--space-2);
  }
  .territory-link {
    margin-top: var(--space-4);
  }
  .prev-next {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .prev-next a[rel='next'] {
    margin-left: auto;
    text-align: right;
  }
  .prev-next .meta-line {
    display: block;
  }
</style>
