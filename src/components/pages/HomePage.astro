---
/**
 * Awake home `/{lang}/`: artist name (`<h1>`), the Dreamland closing border
 * line (`threshold.yaml` `blocks.line`), artist practice, one entry block per
 * territory (statement excerpt + three works) and links to About,
 * Exhibitions and Contact. Meaningful on its own; with a world manifest the
 * drift world enhances it progressively (DriftIsland, plus a "Drift" button
 * shown by the boot script when the visitor is on the awake layer).
 */
import type { Locale } from '../../i18n/RouteMap.js';
import type { TerritoryTeaserView } from '../../domain/TerritoryView.js';
import type { WorldManifest } from '../../world/core/WorldManifest.js';
import { ARTIST_NAME } from '../../content/Publisher.js';
import { localizedPath } from '../../i18n/LocalizedPath.js';
import { uiText } from '../../i18n/UiCatalog.js';
import BaseLayout from '../BaseLayout.astro';
import WorkCard from '../WorkCard.astro';
import DriftIsland from '../DriftIsland.astro';

interface Props {
  lang: Locale;
  territories: readonly TerritoryTeaserView[];
  thresholdLine: string;
  /** Works for the drift world; without it the page is awake-only. */
  world?: WorldManifest;
}

const { lang, territories, thresholdLine, world } = Astro.props;
const ui = uiText(lang);
---
<BaseLayout lang={lang} routeKey="home" title={`${ARTIST_NAME} · iknowyoucanseeme`} description={ui.t('desc_home')}>
  <section class="home-intro">
    <h1>{ARTIST_NAME}</h1>
    <p class="threshold-line">{thresholdLine}</p>
    <p class="artist">{ui.t('artist_practice')}</p>
    {world && (
      <p class="home-drift-actions">
        <button type="button" class="drift-start" data-drift-start hidden>{ui.t('drift')}</button>
        <a
          class="awake-resume"
          href={localizedPath('works', lang)}
          data-awake-resume
          data-resume-template={ui.t('awake_resume_work')}
          hidden
        ></a>
      </p>
    )}
  </section>

  <section class="home-territories" aria-labelledby="territories-heading">
    <h2 id="territories-heading">{ui.t('territories_heading')}</h2>
    {territories.map((t) => (
      <article class="territory-teaser" data-territory={t.slug}>
        <h3><a href={t.href}>{t.title}</a></h3>
        {t.excerpt && <p class="statement">{t.excerpt}</p>}
        <ul class="work-grid">
          {t.featured.map((w) => <li><WorkCard work={w} /></li>)}
        </ul>
        <p><a href={t.href}>{ui.t('territory_link')}</a></p>
      </article>
    ))}
  </section>

  <div class="home-links">
    <ul>
      <li><a href={localizedPath('works', lang)}>{ui.t('works_all_link')}</a></li>
      <li><a href={localizedPath('about', lang)}>{ui.t('nav_about')}</a></li>
      <li><a href={localizedPath('exhibitions', lang)}>{ui.t('nav_exhibitions')}</a></li>
      <li><a href={localizedPath('contact', lang)}>{ui.t('nav_contact')}</a></li>
    </ul>
  </div>
  {world && <DriftIsland slot="world" lang={lang} manifest={world} thresholdLine={thresholdLine} />}
</BaseLayout>

<style>
  section, .home-links {
    padding: var(--space-4) var(--space-3);
    max-width: 72rem;
    margin: 0 auto;
  }
  h1 {
    font-size: var(--text-2xl);
    font-weight: 300;
  }
  .threshold-line {
    font-size: var(--text-xl);
    font-style: italic;
    margin-top: var(--space-2);
    max-width: 40rem;
  }
  .artist {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-top: var(--space-2);
  }
  h2 {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .territory-teaser {
    margin-top: var(--space-4);
  }
  h3 {
    font-size: var(--text-xl);
    font-weight: 400;
  }
  .statement {
    max-width: 40rem;
    margin: var(--space-2) 0 var(--space-3);
  }
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: var(--space-3);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-3);
  }
  .home-drift-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .home-drift-actions:not(:has(:not([hidden]))) {
    display: none;
  }
  .drift-start {
    font: inherit;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-primary);
    background: transparent;
    border: 1px solid var(--text-secondary);
    border-radius: 2px;
    padding: var(--space-2) var(--space-3);
    min-inline-size: max(24px, 1.5rem);
    min-block-size: max(44px, 2.75rem);
    cursor: pointer;
  }
  .drift-start:focus-visible,
  .awake-resume:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }
  .awake-resume {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    padding: var(--space-2) var(--space-3);
    min-inline-size: max(24px, 1.5rem);
    min-block-size: max(24px, 1.5rem);
    border: 1px solid var(--text-secondary);
    border-radius: 2px;
    text-decoration: none;
  }
  .awake-resume:hover {
    color: var(--text-primary);
    border-color: var(--text-primary);
  }
  .awake-resume[hidden] {
    display: none;
  }
  @media (pointer: coarse) {
    .awake-resume,
    .home-links a,
    .territory-teaser h3 a,
    .territory-teaser p a {
      display: inline-flex;
      align-items: center;
      min-inline-size: max(44px, 2.75rem);
      min-block-size: max(44px, 2.75rem);
    }
  }
  .home-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    padding: 0;
  }
  .home-links a {
    display: inline-flex;
    align-items: center;
    min-inline-size: max(24px, 1.5rem);
    min-block-size: max(24px, 1.5rem);
  }
</style>
