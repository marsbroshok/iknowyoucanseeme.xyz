---
/** Exhibitions `/{lang}/exhibitions|expositions/`: reverse-chronological CV list. */
import type { Locale } from '../../i18n/RouteMap.js';
import type { ExhibitionView } from '../../domain/ExhibitionQueries.js';
import { uiText } from '../../i18n/UiCatalog.js';
import BaseLayout from '../BaseLayout.astro';

interface Props {
  lang: Locale;
  exhibitions: readonly ExhibitionView[];
}

const { lang, exhibitions } = Astro.props;
const ui = uiText(lang);
---
<BaseLayout lang={lang} routeKey="exhibitions" title={`${ui.t('nav_exhibitions')} · Alexander Usoltsev`} description={ui.t('desc_exhibitions')}>
  <div class="page">
    <h1>{ui.t('nav_exhibitions')}</h1>
    {exhibitions.length === 0 ? (
      <p class="prose">{ui.t('exhibitions_empty')}</p>
    ) : (
      <ol class="plain-list exhibitions" reversed>
        {exhibitions.map((e) => (
          <li>
            <p class="meta-line">{e.year}</p>
            <p class="exhibition-title"><cite>{e.title}</cite></p>
            <p>{e.venue}{e.dates && ` · ${e.dates}`}</p>
          </li>
        ))}
      </ol>
    )}
  </div>
</BaseLayout>

<style>
  .exhibition-title {
    font-size: var(--text-xl);
  }
  cite {
    font-style: italic;
  }
</style>
