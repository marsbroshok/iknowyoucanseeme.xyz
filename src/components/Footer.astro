---
/**
 * Site footer: copyright line and the legal notice link, both from ui.yaml
 * (`footer_rights`, `nav_legal`) so the footer is in the page language.
 */
import type { Locale } from '../i18n/RouteMap.js';
import { localizedPath } from '../i18n/LocalizedPath.js';
import { uiText } from '../i18n/UiCatalog.js';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const ui = uiText(lang);
const year = new Date().getFullYear();
const legalHref = localizedPath('legal', lang);
---
<footer style="padding: var(--space-3); font-family: var(--font-mono); font-size: var(--text-sm);">
  <p>© {year} Alexander Usoltsev, {ui.t('footer_rights')}. <a href={legalHref}>{ui.t('nav_legal')}</a></p>
</footer>
