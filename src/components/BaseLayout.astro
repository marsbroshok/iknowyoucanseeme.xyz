---
/**
 * Page shell for every awake-layer page: `<html lang>`, title/description,
 * canonical + hreflang alternates, Open Graph, optional JSON-LD, header and
 * footer. Its only JavaScript is the leak's tiny inline script in the head
 * (`LeakScript`: dream colour from the drift, "Clear the leak"); adds
 * GoatCounter's async script only when analytics is enabled
 * (`PUBLIC_GOATCOUNTER_CODE`). The leak's stray apparition waits, hidden,
 * at the end of `<main>`. The `world`
 * slot (home page only) holds the drift layer as a direct child of `<body>`.
 */
import type { Locale, RouteKey } from '../i18n/RouteMap.js';
import { alternateLinks, canonicalUrl, type LocalizedParams } from '../i18n/Alternates.js';
import Header from './Header.astro';
import Footer from './Footer.astro';
import AnalyticsScript from './AnalyticsScript.astro';
import { readAnalyticsConfig, type AnalyticsConfig } from '../analytics/AnalyticsConfig.js';
import { inlineJson } from '../domain/InlineJson.js';
import { leakScript } from '../leak/LeakScript.js';
import '../styles/base.css';

interface Props {
  lang: Locale;
  routeKey: RouteKey;
  routeParams?: LocalizedParams;
  title: string;
  description?: string;
  /** Site-relative path of the Open Graph image (e.g. `/og/arrivee.jpg`). */
  ogImage?: string;
  /** JSON-LD objects to embed in the head. */
  jsonLd?: readonly object[];
  /** Keep the page out of search engines (`<meta name="robots" content="noindex">`). */
  noindex?: boolean;
  /** Analytics settings; defaults to `PUBLIC_GOATCOUNTER_CODE` of the build. */
  analytics?: AnalyticsConfig;
  /** Room for the leak's stray apparition in the margins (off on full-width sheets). */
  apparition?: boolean;
}

const {
  lang,
  routeKey,
  routeParams,
  title,
  description,
  ogImage,
  jsonLd = [],
  noindex = false,
  analytics = readAnalyticsConfig(import.meta.env.PUBLIC_GOATCOUNTER_CODE),
  apparition = true,
} = Astro.props;
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://www.iknowyoucanseeme.xyz';
const canonical = canonicalUrl(routeKey, lang, siteUrl, routeParams);
const alternates = alternateLinks(routeKey, siteUrl, routeParams);
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline set:html={leakScript()} />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {noindex && <meta name="robots" content="noindex" />}

  <link rel="canonical" href={canonical} />
  {alternates.map(alt => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
  ))}

  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
  {ogImage && <meta property="og:image" content={new URL(ogImage, siteUrl).toString()} />}
  {ogImage && <meta property="og:image:width" content="1200" />}
  {ogImage && <meta property="og:image:height" content="630" />}
  <meta name="twitter:card" content="summary_large_image" />
  {jsonLd.map((ld) => <script type="application/ld+json" is:inline set:html={inlineJson(ld)} />)}

  <link rel="preload" href="/fonts/Fraunces.woff2" as="font" type="font/woff2" crossorigin />

  <style is:inline>
    @font-face {
      font-family: 'Fraunces';
      src: url('/fonts/Fraunces.woff2') format('woff2');
      font-weight: 100 900;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'JetBrains Mono';
      src: url('/fonts/JetBrainsMono.woff2') format('woff2');
      font-weight: 100 800;
      font-style: normal;
      font-display: swap;
    }
  </style>
</head>
<body>
  <Header lang={lang} currentRouteKey={routeKey} routeParams={routeParams} />
  <main id="main-content">
    <slot />
    {apparition && (
      <div class="leak-margin" aria-hidden="true">
        <img class="leak-apparition" src="/leak/apparition.webp" alt="" width="224" height="224" loading="lazy" decoding="async" />
      </div>
    )}
  </main>
  <Footer lang={lang} />
  <slot name="world" />
  <AnalyticsScript config={analytics} />
</body>
</html>
