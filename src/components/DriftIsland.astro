---
/**
 * The drift world layer of the home page (progressive enhancement): the
 * canvas, the always-visible "Wake up" control, help text, the horizon
 * compass, the keyboard work list and the build-time world manifest. It is
 * rendered hidden; `bootDrift` shows it on capable devices after first
 * paint and lazy-loads the Three.js world. Without JavaScript, or on the
 * awake layer, the page below is untouched.
 *
 * Rendered in BaseLayout's `world` slot, as a direct child of `<body>`, so
 * the awake page next to it can be made inert while the world is shown.
 */
import type { Locale } from '../i18n/RouteMap.js';
import type { WorldManifest } from '../world/core/WorldManifest.js';
import { uiText } from '../i18n/UiCatalog.js';

interface Props {
  lang: Locale;
  manifest: WorldManifest;
}

const { lang, manifest } = Astro.props;
const ui = uiText(lang);
---
<section class="drift" data-drift hidden tabindex="-1" aria-label={ui.t('drift_layer_label')}>
  <canvas class="drift-canvas" data-drift-canvas aria-hidden="true"></canvas>
  <div class="drift-top">
    <button type="button" class="drift-wake" data-drift-wake>{ui.t('wakeup')}</button>
    <button type="button" class="drift-tilt" data-drift-tilt hidden>{ui.t('drift_tilt')}</button>
  </div>
  <p class="drift-help">{ui.t('drift_help')}</p>
  <div class="drift-compass" data-drift-compass></div>
  <ul class="drift-works" data-drift-works aria-label={ui.t('drift_works_label')}></ul>
</section>
<script type="application/json" id="drift-manifest" set:html={JSON.stringify(manifest)} />

<script>
  import { bootDrift } from '../world/island/DriftBoot.js';
  bootDrift(document, window, () => import('../world/gl/DriftWorld.js'));
</script>

<style is:global>
  html.drift-active,
  html.drift-active body {
    overflow: hidden;
  }
  .drift {
    position: fixed;
    inset: 0;
    z-index: 10;
    background: var(--ink);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    touch-action: none;
  }
  .drift[hidden] {
    display: none;
  }
  .drift:focus {
    outline: none;
  }
  .drift-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
  }
  .drift-canvas:active {
    cursor: grabbing;
  }
  .drift-top {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    display: flex;
    gap: var(--space-2);
  }
  .drift button {
    font: inherit;
    color: var(--text-primary);
    background: rgb(11 16 48 / 0.72);
    border: 1px solid var(--text-secondary);
    border-radius: 2px;
    padding: var(--space-2) var(--space-3);
    min-height: 44px;
    cursor: pointer;
  }
  .drift button:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }
  .drift-help {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    max-width: 22rem;
    margin: 0;
    padding: var(--space-2);
    background: rgb(11 16 48 / 0.72);
    color: var(--text-secondary);
    font-size: var(--text-xs);
  }
  .drift-compass {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--space-2);
    pointer-events: none;
  }
  .drift-compass-here {
    margin: 0 auto var(--space-2);
    width: max-content;
    max-width: 90vw;
    padding: var(--space-1) var(--space-2);
    background: rgb(11 16 48 / 0.72);
    text-align: center;
  }
  .drift-horizon {
    position: relative;
    height: 4.5rem;
    border-top: 1px solid rgb(240 240 245 / 0.25);
  }
  .drift-marker {
    position: absolute;
    top: calc(var(--space-1) + var(--row, 0) * 1.4rem);
    left: calc(var(--x, 0.5) * 100%);
    transform: translateX(-50%);
    white-space: nowrap;
    padding: 0 var(--space-1);
    background: rgb(11 16 48 / 0.72);
    color: var(--text-secondary);
    font-size: var(--text-xs);
  }
  .drift-marker[data-side='left'] {
    transform: none;
  }
  .drift-marker[data-side='right'] {
    transform: translateX(-100%);
  }
  .drift-works {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .drift-works button {
    position: absolute;
    left: 50%;
    bottom: calc(var(--space-5) + var(--space-4));
    transform: translateX(-50%);
    max-width: 90vw;
    opacity: 0;
    pointer-events: none;
  }
  .drift-works button:focus,
  .drift-works button:focus-visible {
    opacity: 1;
    pointer-events: auto;
  }
</style>
