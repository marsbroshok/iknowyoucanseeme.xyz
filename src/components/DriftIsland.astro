---
/**
 * The drift world layer of the home page (progressive enhancement): the
 * canvas, the always-visible "Wake up" control and mute toggle (sound,
 * docs/adr/0011: Tone.js is imported only after the visitor's gesture), help text (and the lens
 * caption, a live region naming the lens in use), the horizon
 * compass, the keyboard work list, the focus dialog, the threshold (the
 * Dreamland border line, the breathing leak's canvas and Enter), the world's text (gaze
 * line and fragments, mirrored into a polite live region) and the
 * build-time world manifest. It is
 * rendered hidden; `bootDrift` shows it on capable devices after first
 * paint and lazy-loads the Three.js world. Without JavaScript, or on the
 * awake layer, the page below is untouched.
 *
 * Rendered in BaseLayout's `world` slot, as a direct child of `<body>`, so
 * the awake page next to it can be made inert while the world is shown.
 */
import type { Locale } from '../i18n/RouteMap.js';
import type { WorldManifest } from '../world/core/WorldManifest.js';
import { uiText } from '../i18n/UiCatalog.js';
import { inlineJson } from '../domain/InlineJson.js';
import { LENS_MODES } from '../world/core/LensMode.js';

interface Props {
  lang: Locale;
  manifest: WorldManifest;
  thresholdLine: string;
}

const { lang, manifest, thresholdLine } = Astro.props;
const ui = uiText(lang);
/** Lens names in the page language, for the live caption (LensAnnouncer). */
const lensNames = JSON.stringify(Object.fromEntries(LENS_MODES.map((m) => [m, ui.t(`lens_${m}`)])));
---
<section class="drift" data-drift hidden tabindex="-1" aria-label={ui.t('drift_layer_label')}>
  <canvas class="drift-canvas" data-drift-canvas aria-hidden="true"></canvas>
  <div class="drift-top">
    <button type="button" class="drift-sound" data-sound-toggle data-label-mute={ui.t('sound_mute')} data-label-unmute={ui.t('sound_unmute')}>{ui.t('sound_mute')}</button>
    <button type="button" class="drift-wake" data-drift-wake>{ui.t('wakeup')}</button>
    <button type="button" class="drift-tilt" data-drift-tilt hidden>{ui.t('drift_tilt')}</button>
  </div>
  <div class="drift-help">
    <p>{ui.t('drift_help')}</p>
    <p>{ui.t('drift_lens_help')}</p>
    <p class="drift-lens" data-drift-lens aria-live="polite" data-lens-names={lensNames}></p>
  </div>
  <ul class="drift-works" data-drift-works aria-label={ui.t('drift_works_label')}></ul>
  <div class="drift-compass" data-drift-compass data-zones-label={ui.t('drift_zones_label')}></div>
  <div class="drift-zone-banner" data-zone-banner hidden>
    <p class="drift-zone-banner-title" data-zone-banner-title></p>
    <p class="drift-zone-banner-subtitle" data-zone-banner-subtitle></p>
  </div>
  <p class="drift-gaze" data-drift-gaze aria-hidden="true">{ui.t('gaze')}</p>
  <p class="drift-fragment" data-drift-fragment aria-hidden="true"></p>
  <p class="drift-specimen" data-drift-specimen aria-hidden="true"></p>
  <p class="drift-said" data-drift-said aria-live="polite"></p>
  <dialog class="drift-focus" data-drift-focus closedby="any" aria-labelledby="drift-focus-title">
    <img class="drift-focus-image" data-focus-image alt="" />
    <h2 id="drift-focus-title" data-focus-title></h2>
    <p class="drift-focus-fragment" data-focus-fragment></p>
    <p class="drift-focus-specimen" data-focus-specimen hidden></p>
    <p data-focus-work-row><a data-focus-work>{ui.t('drift_open_work')}</a></p>
    <p data-focus-contact-row><a data-focus-contact>{ui.t('work_contact_link')}</a></p>
    <figure class="drift-focus-qr" data-focus-qr-row hidden>
      <img data-focus-qr alt={ui.t('kiosk_qr_alt')} width="160" height="160" />
      <figcaption>{ui.t('kiosk_qr')}</figcaption>
    </figure>
    <button type="button" data-focus-close>{ui.t('dialog_close')}</button>
  </dialog>
  <div class="drift-threshold" data-threshold hidden>
    <canvas class="drift-threshold-leak" data-threshold-leak aria-hidden="true"></canvas>
    <p class="drift-threshold-line">{thresholdLine}</p>
    <button type="button" class="drift-enter" data-threshold-enter hidden>{ui.t('enter')}</button>
  </div>
</section>
<script type="application/json" id="drift-manifest" set:html={inlineJson(manifest)} />

<script>
  import { bootDrift } from '../world/island/DriftBoot.js';
  bootDrift(
    document,
    window,
    () => import('../world/gl/DriftWorld.js'),
    undefined,
    undefined,
    () => import('../sound/engine/createSoundEngine.js'),
  );
</script>

<style is:global>
  html.drift-active,
  html.drift-active body {
    overflow: hidden;
  }
  .drift {
    position: fixed;
    inset: 0;
    z-index: 10;
    background: var(--ink);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    touch-action: none;
  }
  .drift[hidden] {
    display: none;
  }
  .drift:focus {
    outline: none;
  }
  .drift-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
  }
  .drift-canvas:active {
    cursor: grabbing;
  }
  .drift-top {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    display: flex;
    gap: var(--space-2);
    /* Above the threshold: "Wake up" is never covered (FR4). */
    z-index: 2;
  }
  .drift button {
    font: inherit;
    color: var(--text-primary);
    background: rgb(11 16 48 / 0.72);
    border: 1px solid var(--text-secondary);
    border-radius: 2px;
    padding: var(--space-2) var(--space-3);
    min-height: 44px;
    cursor: pointer;
  }
  .drift button:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }
  .drift-help {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    max-width: 22rem;
    margin: 0;
    padding: var(--space-2);
    background: rgb(11 16 48 / 0.72);
    color: var(--text-secondary);
    font-size: var(--text-xs);
  }
  .drift-help p {
    margin: 0;
  }
  .drift-help p + p {
    margin-top: var(--space-1);
  }
  .drift-lens {
    color: var(--text-primary);
  }
  .drift-lens:empty {
    display: none;
  }
  .drift-compass {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--space-2);
    pointer-events: none;
  }
  .drift-compass-here {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .drift-horizon {
    position: relative;
    height: 2.5rem;
    border-top: 1px solid rgb(240 240 245 / 0.2);
    pointer-events: none;
  }
  .drift-marker {
    position: absolute;
    top: calc(var(--space-1) + var(--row, 0) * 1.2rem);
    left: calc(var(--x, 0.5) * 100%);
    transform: translateX(-50%);
    white-space: nowrap;
    padding: 0 var(--space-1);
    background: rgb(11 16 48 / 0.72);
    color: var(--text-secondary);
    font-size: var(--text-xs);
  }
  .drift-marker[data-side='left'] {
    transform: none;
  }
  .drift-marker[data-side='right'] {
    transform: translateX(-100%);
  }
  .drift-zones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1);
    padding: 0 var(--space-2);
    pointer-events: auto;
  }
  .drift .drift-zone-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    min-height: 44px;
    border-radius: 999px;
    border: 1px solid rgb(160 165 181 / 0.45);
    background: rgb(7 11 34 / 0.84);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    transition: border-color var(--motion-duration) var(--motion-easing), color var(--motion-duration) var(--motion-easing), background-color var(--motion-duration) var(--motion-easing);
  }
  .drift .drift-zone-pill::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--zone-accent, var(--text-secondary));
    opacity: 0.45;
    transform: scale(0.75);
    transition: opacity var(--motion-duration) var(--motion-easing), transform var(--motion-duration) var(--motion-easing);
  }
  .drift .drift-zone-pill[data-active='true'] {
    border-color: var(--zone-accent, var(--text-primary));
    background: rgb(11 16 48 / 0.94);
    color: var(--text-primary);
    box-shadow: 0 0 0 1px var(--zone-accent, var(--text-primary));
  }
  .drift .drift-zone-pill[data-active='true']::before {
    opacity: 1;
    transform: scale(1);
  }
  .drift-zone-banner {
    position: absolute;
    left: 50%;
    top: 24%;
    transform: translate(-50%, -50%);
    width: min(34rem, 88vw);
    padding: var(--space-3) var(--space-4);
    background: rgb(7 11 34 / 0.9);
    border-block: 1px solid var(--zone-accent, var(--text-secondary));
    border-radius: 4px;
    box-shadow: 0 8px 32px rgb(3 5 18 / 0.65);
    text-align: center;
    pointer-events: none;
  }
  .drift-zone-banner[hidden] {
    display: none;
  }
  .drift-zone-banner-title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-2xl);
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--zone-accent, var(--text-primary));
  }
  .drift-zone-banner-subtitle {
    margin: var(--space-2) 0 0;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-style: italic;
    font-weight: 300;
    line-height: 1.45;
    color: var(--text-primary);
  }
  .drift-zone-banner-subtitle[hidden] {
    display: none;
  }
  .drift-focus {
    max-width: min(40rem, 92vw);
    max-height: 92vh;
    padding: var(--space-3);
    background: var(--ink);
    color: var(--text-primary);
    border: 1px solid var(--text-secondary);
    font-family: var(--font-sans);
    font-size: var(--text-base);
  }
  .drift-focus::backdrop {
    background: rgb(11 16 48 / 0.6);
  }
  .drift-focus-image {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 60vh;
    margin: 0 auto var(--space-3);
  }
  .drift-focus h2 {
    font-size: var(--text-xl);
    font-weight: 400;
    margin: 0 0 var(--space-2);
  }
  .drift-focus-fragment {
    font-style: italic;
    margin: 0 0 var(--space-3);
  }
  .drift-focus a {
    color: var(--text-primary);
  }
  .drift-focus-specimen {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    margin: 0 0 var(--space-3);
  }
  .drift-focus-qr {
    margin: 0 0 var(--space-3);
  }
  .drift-focus-qr img {
    display: block;
    width: 10rem;
    height: 10rem;
    background: #fff;
  }
  /* Exhibition mode: the cursor hides after 5 s without input (KioskMode). */
  html.kiosk-idle,
  html.kiosk-idle * {
    cursor: none !important;
  }
  .drift-threshold {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--ink);
    opacity: 1;
    transition: opacity 1.6s ease;
  }
  .drift-threshold[hidden] {
    display: none;
  }
  .drift-threshold[data-kind='short'] {
    transition-duration: 1s;
  }
  .drift-threshold[data-phase='leaving'] {
    opacity: 0;
    pointer-events: none;
  }
  .drift-threshold-leak {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .drift-threshold-line,
  .drift .drift-enter {
    position: relative;
  }
  .drift-threshold-line {
    margin: 0;
    max-width: 36rem;
    padding: var(--space-2) var(--space-3);
    background: rgb(7 11 34 / 0.62);
    border-radius: 4px;
    text-shadow: 0 1px 12px rgb(7 11 34 / 0.95);
    font-family: var(--font-sans);
    font-size: var(--text-xl);
    font-weight: 300;
    font-style: italic;
    text-align: center;
    color: var(--text-primary);
  }
  .drift .drift-enter {
    font-family: var(--font-sans);
    font-size: var(--text-lg);
    letter-spacing: 0.08em;
    padding: var(--space-2) var(--space-4);
  }
  .drift-gaze,
  .drift-fragment {
    position: absolute;
    margin: 0;
    pointer-events: none;
    font-family: var(--font-sans);
    font-style: italic;
    font-weight: 300;
    color: var(--text-primary);
    text-align: center;
    text-shadow: 0 0 1.2rem var(--ink), 0 0 0.3rem var(--ink);
  }
  .drift-gaze {
    left: 50%;
    top: 38%;
    transform: translate(-50%, -50%);
    width: max-content;
    max-width: 80vw;
    font-size: var(--text-2xl);
    letter-spacing: 0.04em;
    filter: blur(0.4px);
  }
  .drift-fragment {
    left: var(--x, 50%);
    top: var(--y, 30%);
    transform: translate(-50%, -100%);
    max-width: min(26rem, 80vw);
    font-size: var(--text-lg);
    line-height: 1.4;
  }
  .drift-fragment:empty {
    display: none;
  }
  /* A specimen's museum tag, under its work (WorldWhisper.specimen). */
  .drift-specimen {
    position: absolute;
    left: var(--x, 50%);
    top: var(--y, 70%);
    transform: translate(-50%, 0.5rem);
    margin: 0;
    pointer-events: none;
    padding: var(--space-1) var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--text-primary);
    background: rgb(11 16 48 / 0.72);
    border: 1px solid var(--text-secondary);
    transition: opacity 600ms ease-out;
  }
  .drift-specimen:empty {
    display: none;
  }
  .drift-said {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .drift-works {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .drift-works button {
    position: absolute;
    left: 50%;
    bottom: 9rem;
    transform: translateX(-50%);
    max-width: 90vw;
    opacity: 0;
    pointer-events: none;
  }
  .drift-works button:focus,
  .drift-works button:focus-visible {
    opacity: 1;
    pointer-events: auto;
  }
</style>
